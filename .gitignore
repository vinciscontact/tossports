# Raw source footage — 266MB of .MOV masters that the site never serves.
# The storefront uses the compressed reel at images/reel/toss-reel.mp4.
images/marketing video/

# Secrets. .env.example is the map and IS committed; a real .env never is.
# Nothing in the browser reads these — this site has no build step — so a
# .env here would only ever be a place a service_role key goes to die.
.env
.env.*
!.env.example

