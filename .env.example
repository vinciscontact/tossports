#  TOSS SPORTS — EVERY KEY, AND WHERE IT ACTUALLY GOES
#
#  Copy to `.env` if you want one file to keep them in. `.env` is
#  gitignored; this example is committed and must never hold a real secret.
#
#  ────────────────────────────────────────────────────────────────────
#  READ THIS FIRST
#
#  The website does NOT read this file. It cannot: the storefront is
#  plain HTML and JS with no build step (PRD NFR-7), so there is no
#  bundler to substitute a value in, and no server to read one at
#  runtime. Nothing here reaches the browser by itself.
#
#  So this file is a MAP, not a mechanism. Each entry says where the
#  value really has to be pasted for it to take effect. Copying a value
#  in here and nowhere else changes nothing.
#
#  That is not a limitation to work around. Three of the values below
#  are secrets that must never sit in a folder that gets zipped, shared
#  or pushed — keeping them out of the repository is the point.
#
#  ────────────────────────────────────────────────────────────────────
#  WHERE THINGS GO, AT A GLANCE
#
#    js/config.js .................. public values, committed on purpose
#    Maze Room → Settings .......... business values the owner changes
#    Supabase dashboard ............ auth providers, SMTP
#    Apps Script → Script Properties  the Sheets sync only
#    Nowhere in this repo .......... every real secret


# ══════════════════════════════════════════════════════════════════════
#  1. PUBLIC — already in js/config.js, safe in page source
# ══════════════════════════════════════════════════════════════════════
#
#  These are protected by Row Level Security, not by being hidden. They
#  are printed in the page source of every visitor and that is correct.
#  Change them in js/config.js; they are listed here only so one file
#  answers "what are we connected to".

SUPA_URL=https://rbrokxstbzewdjdfhiwk.supabase.co
SUPA_PUBLISHABLE_KEY=sb_publishable_RsGkbtn8GloAZxGFKWz-Ew_m6KGKyJn

# Contact + social. js/config.js → TOSS_LINKS
TOSS_WHATSAPP=919176995707
TOSS_WHATSAPP_COMMUNITY=https://chat.whatsapp.com/JxcsJgTyLHw4exbmwXYZn4
TOSS_WHATSAPP_OFFERS=
TOSS_INSTAGRAM=https://www.instagram.com/toss_sportz

# Analytics. Empty means no tag is injected at all — see js/config.js.
GA4_ID=
META_PIXEL_ID=


# ══════════════════════════════════════════════════════════════════════
#  2. SUPABASE DASHBOARD — not a file, not this one
# ══════════════════════════════════════════════════════════════════════
#
#  Authentication → Providers → Google.
#  The Client ID is public; the Secret is NOT and must only ever be
#  pasted into the Supabase dashboard. Get both from Google Cloud
#  Console → APIs & Services → Credentials.
#
#  Authorised redirect URI in Google Cloud must be exactly:
#    https://rbrokxstbzewdjdfhiwk.supabase.co/auth/v1/callback

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=      # ← Supabase dashboard ONLY. Never here.

#  Authentication → URL Configuration → Redirect URLs.
#  Sign-in is refused if the return address is not on this list.
AUTH_REDIRECT_URLS=http://localhost:4321/**,https://tossports.in/**

#  Project Settings → Authentication → SMTP.
#  Needed before a single signup confirmation or password reset can be
#  delivered — the built-in mailer sends 2 an hour for the whole project.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=                   # ← Supabase dashboard ONLY. Never here.
SMTP_SENDER=orders@tossports.in


# ══════════════════════════════════════════════════════════════════════
#  3. MAZE ROOM → SETTINGS — stored in the database
# ══════════════════════════════════════════════════════════════════════
#
#  These live in the `settings` table so the owner can change a price or
#  a phone number without a developer. Editing them here does nothing;
#  edit them in the Maze Room. Listed for reference and defaults.

RAZORPAY_KEY_ID=                 # Maze Room → Settings → Razorpay key id
RAZORPAY_KEY_SECRET=             # ← Razorpay dashboard ONLY. Never here,
                                 #   never in the browser. Only needed if
                                 #   payment verification moves server-side.

SHIP_FEE=99
FREE_SHIP_OVER=1500
ENGRAVING_PRICE=199
WARRANTY_3_PRICE=100
WARRANTY_6_PRICE=200


# ══════════════════════════════════════════════════════════════════════
#  4. APPS SCRIPT → SCRIPT PROPERTIES — the Sheets sync only
# ══════════════════════════════════════════════════════════════════════
#
#  sheets-sync/Code.gs reads these from Script Properties, which is
#  server side and outside this repository. See sheets-sync/README.md.
#
#  SUPA_SERVICE bypasses EVERY row-level security policy in the
#  database. It can read every order, every salary and every payslip.
#  It belongs in Script Properties and nowhere else — not in a cell,
#  not in a .env, not in a message. If it leaks, rotate it in the
#  Supabase dashboard immediately; nothing else will contain it.

SUPA_SERVICE_ROLE_KEY=           # ← Apps Script Script Properties ONLY.


# ══════════════════════════════════════════════════════════════════════
#  5. NEVER STORED ANYWHERE IN THIS PROJECT
# ══════════════════════════════════════════════════════════════════════
#
#  POSTGRES_PASSWORD — the direct database password. Nothing in this
#  codebase connects with it; everything goes through PostgREST with a
#  key above. PRD C6 already flags that it was shared in plaintext
#  during setup and needs rotating.
